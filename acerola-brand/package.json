{
	"name": "acerola-brand",
	"private": true,
	"license": "MPL-2.0",
	"version": "0.2.3",
	"type": "module",
	"scripts": {
		"kit": "node scripts/kit.mjs",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"generate": "npm run i18n && npm run kit",
		"dev": "npm run generate && vite dev",
		"build": "npm run generate && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.2",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fflate": "^0.8.3",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "^1.61.0",
		"gsap": "^3.15.1",
		"lenis": "^1.3.27"
	},
	"engines": {
		"node": ">=22.18"
	},
	"overrides": {
		"@sveltejs/kit": "$@sveltejs/kit"
	}
}
