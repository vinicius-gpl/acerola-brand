# Deploy values for the brand book. They are read by the Deploy/Site workflow from the GitHub
# repository (Settings → Secrets and variables → Actions), not from this file: fill a copy as
# .env and register it with the commands at the end.

# --- Secrets (R2 API token with Object Read & Write on the acerola-cdn bucket only) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Variables ---
# Bucket the workflow uploads brand/ and downloads/ to.
R2_BUCKET=acerola-cdn
# Public address of that bucket: the site's download links and snippets point here.
ASSETS_URL=https://cdn.acerola.app
# Public address of the site, for sitemap.xml and robots.txt (this is already the default).
SITE_URL=https://brand.acerola.app

# Register in the repository (run from acerola-brand/):
#   bash -c "gh secret set -f <(grep -E '^R2_(ACCOUNT_ID|ACCESS_KEY_ID|SECRET_ACCESS_KEY)=' .env)"
#   bash -c "gh variable set -f <(grep -E '^(R2_BUCKET|ASSETS_URL|SITE_URL)=' .env)"
